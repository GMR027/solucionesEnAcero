# Copia este archivo como includes/.env para desarrollo local.
APP_ENV=desarrollo

# Base de datos de cotizaciones
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cotizaciones
DB_USER=portal_soluciones
DB_PASSWORD=

# --- Portal de clientes ------------------------------------------------------
# Usuario MySQL creado con cotizaciones/scripts/crear_usuario_portal.sh
# (en el cluster: DB_HOST=mysql.cotizaciones.svc.cluster.local)
EMPRESA_ID=1

# Instancia de cotizaciones que sirve /portal/entregas/foto
# (en el cluster: http://cotizaciones.cotizaciones.svc.cluster.local)
COTIZACIONES_URL=http://127.0.0.1:8000
# Mismo valor que PORTAL_FOTOS_SECRETO en cotizaciones (openssl rand -hex 32)
PORTAL_FOTOS_SECRETO=
